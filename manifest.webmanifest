{
  "name": "Convoy — everyone on one map",
  "short_name": "Convoy",
  "description": "See everyone in your group on one map, with the time each person will reach the destination. No sign-up, no backend.",
  "id": ".",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#f2f2f7",
  "theme_color": "#f2f2f7",
  "lang": "en",
  "dir": "ltr",
